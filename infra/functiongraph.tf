# ============================================
# FunctionGraph - Logistics Agent
# ============================================
#
# Note: The function code is defined inline below for simplicity.
# For production use, you can package src/agent.py and dependencies
# as a zip file and use:
#   code_type = "zip"
#   code_zip_file = "path/to/function.zip"
#
# The source code is available in: src/agent/agent.py
# Dependencies are in: src/agent/requirements.txt
# ============================================

resource "huaweicloud_fgs_function" "logistics_query" {
  name        = "${var.project_name}-query"
  app         = "default"
  description = "Logistics agent query function"
  runtime    = "Python3.9"
  handler    = "index.handler"
  memory_size = 512
  timeout    = 60

  code_type = "inline"
  # Inline base64 encoded function code
  func_code = ""

  timeouts {
    create = "20m"
    delete = "20m"
  }
}
